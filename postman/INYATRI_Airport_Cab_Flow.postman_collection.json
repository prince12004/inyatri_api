    {
      "name": "5. Payment Callback Simulators (PayU)",
      "description": "Simulate PayU gateway callbacks specifically for airport bookings.",
      "item": [
        {
          "name": "Simulate PayU Success Callback (Airport)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "txnid",
                  "value": "{{payu_txn_id}}",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "success",
                  "type": "text"
                },
