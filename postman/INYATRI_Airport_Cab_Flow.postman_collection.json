          "name": "Step 5 - Checkout Booking & Generate PayU Form (Auto-saves booking_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
