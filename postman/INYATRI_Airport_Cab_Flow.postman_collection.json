              "raw": "{{baseUrl}}/api/user/v1/cab/bookings/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "v1",
                "cab",
                "bookings",
                "checkout"
              ]
            }
